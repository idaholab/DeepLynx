# Stage 1: Build the frontend
FROM node:lts-alpine AS frontend-build

# Set working directory
WORKDIR /usr/src/app

# Copy dependency metadata first
COPY deeplynx.docs/package.json deeplynx.docs/package-lock.json ./

# Install frontend dependencies
RUN --mount=type=cache,target=/root/.npm npm ci

# Copy the rest of the frontend source code
COPY deeplynx.docs ./

# Build the frontend
RUN npm run build

# Stage 2: Create the final image
FROM node:lts-alpine AS final

# Set working directory
WORKDIR /usr/src/app

# Install versioned os packages
#RUN apk update && apk upgrade --no-cache

# Copy the built frontend code from the previous stage
COPY --from=frontend-build /usr/src/app .

# Install production dependencies
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev

# Explicitly set user
RUN addgroup -S nexus && adduser -S nexus -G nexus
RUN chown -R nexus:nexus /usr/src/app
USER nexus

# Expose the port the app runs on
EXPOSE 3001

# Set the command to run the application
CMD ["npm", "start"]
