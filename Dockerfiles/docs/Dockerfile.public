# Stage 1: Build the frontend
FROM node:lts-alpine AS frontend-build

# Set working directory
WORKDIR /usr/src/app

# Install versioned os packages
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    busybox

# Install latest global npm version and packages
RUN npm install -g npm@latest

# Copy package.json first
COPY deeplynx.docs/package*.json ./

# Install frontend dependencies
RUN npm install \
    && ( \
    set -e; \
    tmp="$(mktemp -d)"; \
    cd "$tmp"; \
    npm pack picomatch@4.0.4; \
    tar -xzf picomatch-4.0.4.tgz; \
    rm -rf /usr/src/app/node_modules/tinyglobby/node_modules/picomatch; \
    mkdir -p /usr/src/app/node_modules/tinyglobby/node_modules; \
    mv package /usr/src/app/node_modules/tinyglobby/node_modules/picomatch; \
    cd /; rm -rf "$tmp"; \
    ) || true \
    && node -e "try{console.log('build-stage app tinyglobby nested picomatch:', require('/usr/src/app/node_modules/tinyglobby/node_modules/picomatch/package.json').version)}catch(e){console.log('build-stage app tinyglobby nested picomatch not found')}"

# Copy the rest of the frontend source code
COPY deeplynx.docs .

# Build the frontend
RUN npm run build

# Stage 2: Create the final image
FROM node:lts-alpine AS final

# Set working directory
WORKDIR /usr/src/app

# Install versioned os packages
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    busybox

# Install latest global npm version and packages
RUN npm install -g npm@latest \
    && ( \
    set -e; \
    tmp="$(mktemp -d)"; \
    cd "$tmp"; \
    npm pack minimatch@10.2.4 >/dev/null 2>&1 || npm pack minimatch@10.2.3 >/dev/null 2>&1; \
    tar -xzf minimatch-*.tgz; \
    rm -rf /usr/local/lib/node_modules/npm/node_modules/minimatch; \
    mv package /usr/local/lib/node_modules/npm/node_modules/minimatch; \
    cd /; rm -rf "$tmp"; \
    ) || true \
    && ( \
    set -e; \
    tmp="$(mktemp -d)"; \
    cd "$tmp"; \
    npm pack picomatch@4.0.4 >/dev/null 2>&1; \
    tar -xzf picomatch-4.0.4.tgz; \
    rm -rf /usr/local/lib/node_modules/npm/node_modules/tinyglobby/node_modules/picomatch; \
    mkdir -p /usr/local/lib/node_modules/npm/node_modules/tinyglobby/node_modules; \
    mv package /usr/local/lib/node_modules/npm/node_modules/tinyglobby/node_modules/picomatch; \
    cd /; rm -rf "$tmp"; \
    ) || true \
    && node -e "try{console.log('npm-bundled minimatch now:', require('/usr/local/lib/node_modules/npm/node_modules/minimatch/package.json').version)}catch(e){console.log('npm-bundled minimatch not found')}" \
    && node -e "try{console.log('npm-bundled tinyglobby nested picomatch now:', require('/usr/local/lib/node_modules/npm/node_modules/tinyglobby/node_modules/picomatch/package.json').version)}catch(e){console.log('npm-bundled tinyglobby nested picomatch not found')}"

# Copy the built frontend code from the previous stage
COPY --from=frontend-build /usr/src/app .

# Install production dependencies
RUN npm install --omit=dev

# Explicitly set user
RUN addgroup -S nexus && adduser -S nexus -G nexus
RUN chown -R nexus:nexus /usr/src/app
USER nexus

# Expose the port the app runs on
EXPOSE 3001

# Set the command to run the application
CMD ["npm", "start"]
