# Stage 1: Build the frontend
FROM node:22-alpine AS frontend-build

# Set working directory
WORKDIR /usr/src/app

# Copy dependency metadata first
COPY deeplynx.docs/package.json deeplynx.docs/package-lock.json ./

# Install frontend dependencies
RUN npm ci

# Copy the rest of the frontend source code
COPY deeplynx.docs ./

# Patch 2026-33671
RUN set -eux; \
    cd /usr/src/app; \
    target="node_modules/next/dist/compiled/picomatch"; \
    test -d "$target"; \
    wget -q -O /tmp/picomatch-4.0.4.tgz https://registry.npmjs.org/picomatch/-/picomatch-4.0.4.tgz; \
    echo "515b5ab666558ed9a117483a310892aede54a68dd78f2d8db6604513e578571c  /tmp/picomatch-4.0.4.tgz" | sha256sum -c -; \
    rm -rf "$target"/*; \
    tar -xzf /tmp/picomatch-4.0.4.tgz --strip-components=1 -C "$target"; \
    rm -f /tmp/picomatch-4.0.4.tgz; \
    grep -q '"version": "4.0.4"' "$target/package.json"

# Build the frontend
RUN npm run build

# Stage 2: Create the final image
FROM node:22-alpine AS final

# Set working directory
WORKDIR /usr/src/app

# Copy standalone runtime output and 
USER root
COPY --from=frontend-build /usr/src/app/.next/standalone ./
COPY --from=frontend-build /usr/src/app/.next/static ./.next/static
COPY --from=frontend-build /usr/src/app/public ./public

# Allow runtime cache in case of (future) dhi perm blocking
RUN mkdir -p /usr/src/app/.next/cache \
    && chown -R node:node /usr/src/app

# RM bundled npm as we use standalone out. Delete if application runtime npm required 
RUN rm -rf /usr/local/lib/node_modules/npm && rm -rf /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm && rm -f /usr/local/bin/corepack

# User account
USER node

# Set the port the app runs on
ENV PORT=3001

# Expose the port the app runs on
EXPOSE 3001

# Set the command to run the application
CMD ["node", "server.js"]
