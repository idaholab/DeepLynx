# Stage 1: Build the frontend
FROM node:lts-alpine AS frontend-build

# Set working directory
WORKDIR /usr/src/app

# Install versioned os packages
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    busybox

# Install latest global npm version and packages
RUN npm install -g npm@latest

# Copy package.json first
COPY deeplynx.UI/package*.json ./

# Install frontend dependencies
RUN npm install

# Copy the rest of the frontend source code
COPY deeplynx.UI .

# Build the frontend
RUN npm run build

# Stage 2: Create the final image
FROM node:lts-alpine AS final

# Set working directory
WORKDIR /usr/src/app

# Install versioned os packages
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    busybox

# Install latest global npm version and packages
RUN npm install -g npm@latest

# Copy package files first
COPY --from=frontend-build /usr/src/app/package*.json ./

# Install production dependencies BEFORE copying build artifacts
RUN npm install --omit-dev

# NOW copy the built application (including .next folder)
COPY --from=frontend-build /usr/src/app/.next ./.next
COPY --from=frontend-build /usr/src/app/public ./public
# COPY --from=frontend-build /usr/src/app/next.config.js ./next.config.js

# Explicitly set user
RUN addgroup -S nexus && adduser -S nexus -G nexus
RUN chown -R nexus:nexus /usr/src/app
USER nexus

# Expose the port the app runs on
EXPOSE 3000

# Set the command to run the application
CMD ["npm", "start"]