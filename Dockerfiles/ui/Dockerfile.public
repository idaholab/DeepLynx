# Stage 1: Build the frontend
FROM node:24.14.1-alpine3.23 AS frontend-build

# Set working directory
WORKDIR /usr/src/app

# Copy dependency metadata first for better cache reuse
COPY deeplynx.UI/package.json deeplynx.UI/package-lock.json ./

# Install frontend dependencies
RUN npm ci

# Copy the rest of the frontend source code
COPY deeplynx.UI ./

# Build the frontend
RUN npm run build

# Stage 2: Create the final image
FROM chainguard/node:latest AS final

# Set working directory
WORKDIR /usr/src/app

# Copy standalone runtime output and allow runtime cache
USER root
COPY --chown=65532:65532 --from=frontend-build /usr/src/app/.next/standalone ./
COPY --chown=65532:65532 --from=frontend-build /usr/src/app/.next/static ./.next/static
COPY --chown=65532:65532 --from=frontend-build /usr/src/app/public ./public
RUN mkdir -p /app/.next/cache && chown -R 65532:65532 /app
USER 65532

# Expose the port the app runs on
EXPOSE 3000

# Set the command to run the application
CMD ["server.js"]