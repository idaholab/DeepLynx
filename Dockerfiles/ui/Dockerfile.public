# Stage 1: Build the frontend
FROM node:24.14.1-alpine3.23 AS frontend-build

# Set working directory
WORKDIR /usr/src/app

# Copy dependency metadata first for better cache reuse
COPY deeplynx.UI/package.json deeplynx.UI/package-lock.json ./

# Install frontend dependencies
RUN npm ci

# Copy the rest of the frontend source code
COPY deeplynx.UI ./

# Build the frontend
RUN npm run build

# Stage 2: Create the final image
FROM node:22-alpine AS final

# Set working directory
WORKDIR /usr/src/app

# Copy standalone runtime output and 
USER root
COPY --from=frontend-build /usr/src/app/.next/standalone ./
COPY --from=frontend-build /usr/src/app/.next/static ./.next/static
COPY --from=frontend-build /usr/src/app/public ./public

# Allow runtime cache in case of (future) dhi perm blocking
RUN mkdir -p /usr/src/app/.next/cache \
    && chown -R node:node /usr/src/app

# RM bundled npm as we use standalone out. Delete if application runtime npm required 
RUN rm -rf /usr/local/lib/node_modules/npm && rm -rf /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm && rm -f /usr/local/bin/corepack

# User account
USER node

# Expose the port the app runs on
EXPOSE 3000

# Set the command to run the application
CMD ["node", "server.js"]