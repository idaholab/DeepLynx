# Stage 1: Build the frontend
FROM node:22-alpine AS frontend-build

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_VERSION=v1
ARG NEXT_PUBLIC_DISABLE_FRONTEND_AUTHENTICATION=false
ARG BACKEND_BASE_URL

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_API_VERSION=${NEXT_PUBLIC_API_VERSION}
ENV NEXT_PUBLIC_DISABLE_FRONTEND_AUTHENTICATION=${NEXT_PUBLIC_DISABLE_FRONTEND_AUTHENTICATION}
ENV BACKEND_BASE_URL=${BACKEND_BASE_URL}

# Set working directory
WORKDIR /usr/src/app

# Copy dependency metadata first for better cache reuse
COPY deeplynx.UI/package.json deeplynx.UI/package-lock.json ./

# Install frontend dependencies
RUN --mount=type=cache,target=/root/.npm npm ci

# Copy the rest of the frontend source code
COPY deeplynx.UI ./

# Patch 2026-33671
RUN set -eux; \
    target="/usr/src/app/node_modules/next/dist/compiled/picomatch"; \
    test -d "$target"; \
    tmp="$(mktemp -d)" && cd "$tmp"; \
    npm pack picomatch@4.0.4; \
    rm -rf "$target"/*; \
    tar -xzf picomatch-4.0.4.tgz --strip-components=1 -C "$target"; \
    test -f "$target/package.json" && grep -q '"version": "4.0.4"' "$target/package.json"; \
    cd / && rm -rf "$tmp"

# Build the frontend. Public browser calls default to the same-origin ingress;
# reject addresses that cannot work from an HTTPS deployment.
RUN set -eu; \
    export NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL:-/api}"; \
    export NEXT_PUBLIC_API_VERSION="${NEXT_PUBLIC_API_VERSION:-v1}"; \
    case "$NEXT_PUBLIC_API_URL" in \
        /*|https://*) ;; \
        *) echo "NEXT_PUBLIC_API_URL must be a same-origin path or an HTTPS URL, got: $NEXT_PUBLIC_API_URL" >&2; exit 1 ;; \
    esac; \
    case "$NEXT_PUBLIC_API_URL" in \
        *localhost*|*127.0.0.1*) echo "NEXT_PUBLIC_API_URL must not target localhost in a public image" >&2; exit 1 ;; \
    esac; \
    npm run build

# Stage 2: Create the final image
FROM node:22-alpine AS final

# Set working directory
WORKDIR /usr/src/app

# Run time env vars
ENV NODE_ENV=production

# Copy standalone runtime output and 
USER root
COPY --from=frontend-build /usr/src/app/.next/standalone ./
COPY --from=frontend-build /usr/src/app/.next/static ./.next/static
COPY --from=frontend-build /usr/src/app/public ./public

# Allow runtime cache in case of (future) dhi perm blocking
RUN mkdir -p /usr/src/app/.next/cache \
    && chown -R node:node /usr/src/app

# RM bundled npm as we use standalone out. Delete if application runtime npm required 
RUN rm -rf /usr/local/lib/node_modules/npm && rm -rf /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm && rm -f /usr/local/bin/corepack

# Update openssl
RUN set -eux; \
    apk update; \
    apk upgrade --no-cache openssl libcrypto3 libssl3; \
    rm -rf /var/cache/apk/*

# User account
USER node

# Expose the port the app runs on
EXPOSE 3000

# Set the command to run the application
CMD ["node", "server.js"]
