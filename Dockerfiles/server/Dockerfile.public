# Stage 1: Build the C# backend
FROM mcr.microsoft.com/dotnet/sdk:10.0.302 AS backend-build

# Set working directory
WORKDIR /usr/src/app

# Copy the solution file and restore dependencies
COPY deeplynx.sln .
COPY deeplynx.api ./deeplynx.api
COPY deeplynx.business ./deeplynx.business
COPY deeplynx.datalayer ./deeplynx.datalayer
COPY deeplynx.helpers ./deeplynx.helpers
COPY deeplynx.interfaces ./deeplynx.interfaces
COPY deeplynx.models ./deeplynx.models
COPY deeplynx.tests ./deeplynx.tests
RUN dotnet restore deeplynx.sln

# Build the backend
RUN dotnet build deeplynx.sln -c Release -o /app/build

# Publish the backend
FROM backend-build AS publish
RUN dotnet publish deeplynx.sln -c Release -o /app/publish /p:UseAppHost=false

# Stage 2: Create the final image
FROM mcr.microsoft.com/dotnet/aspnet:10.0.11 AS final

# Set working directory
WORKDIR /usr/src/app

# Fix vulnerability
RUN apt-get update && \
    apt-get upgrade -y && \
    rm -rf /var/lib/apt/lists/*

# # Configure INL certs and environment variables (needed here because this is
# # the image that actually runs the app, and native deps like DuckDB's azure
# # extension use their own CA bundle rather than the .NET/OS trust store)
# RUN apt-get update && \
#     apt-get install -y --no-install-recommends wget ca-certificates && \
#     rm -rf /var/lib/apt/lists/*
# RUN wget -q -P /usr/local/share/ca-certificates/ http://certstore.inl.gov/pki/CAINLROOT_B64.crt
# RUN /usr/sbin/update-ca-certificates
# ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
# ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# ENV SSL_CERT_DIR=/etc/ssl/certs/
# # DuckDB's azure extension (curl transport) specifically honors these two,
# # not the more common SSL_CERT_FILE/CURL_CA_BUNDLE above.
# ENV CURL_CA_INFO=/etc/ssl/certs/ca-certificates.crt
# ENV CURL_CA_PATH=/etc/ssl/certs/

# Copy the published backend code
COPY --from=publish /app/publish .

# Copy additional files if needed
COPY deeplynx.api/moon.css ./moon.css

# Explicitly set user
RUN groupadd -r nexus && useradd -r -g nexus -m -s /usr/sbin/nologin nexus
RUN chown -R nexus:nexus /usr/src/app
USER nexus

# This will run the .NET application directly
CMD ["dotnet", "deeplynx.api.dll", "--urls", "http://*:5000;http://*:50051"]
